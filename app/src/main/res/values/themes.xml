<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DayanCalculator" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowBackground">#0F172A</item>
    </style>

    <!-- Android 12+ SplashScreen (backported via androidx.core:core-splashscreen down to
         minSdk). Shown as the very first frame on cold launch: dark navy background, DAYAN brand
         icon (same inset foreground artwork as the launcher icon), then hands off to the real
         app theme once the first frame is drawn. Set as MainActivity's manifest theme; the
         SplashScreen library switches to postSplashScreenTheme automatically. -->
    <style name="Theme.DayanCalculator.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DayanCalculator</item>
    </style>
</resources>
