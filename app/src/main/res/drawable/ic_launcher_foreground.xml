<?xml version="1.0" encoding="utf-8"?>
<!-- DAYAN brand mark, inset to fit the adaptive-icon safe zone (~64% of the 108dp canvas is
     guaranteed visible across launcher masks) without stretching, cropping, or adding any extra
     colored background behind the supplied artwork - dayan_app_icon.png already carries its own
     rounded-square navy/blue styling. Also reused as the Android 12+ splash-screen icon. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/dayan_app_icon"
    android:insetLeft="18%"
    android:insetTop="18%"
    android:insetRight="18%"
    android:insetBottom="18%" />
